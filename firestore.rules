rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Productos: Lectura pública para el catálogo web, escritura solo autenticados
    match /products/{productId} {
      allow read: if true; // Lectura pública para visitantes
      allow write: if request.auth != null; // Solo usuarios autenticados pueden escribir
    }
    
    // Categorías: Lectura pública, escritura autenticada
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Servicios públicos: Lectura pública, escritura autenticada
    match /public_services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Contenido del sitio web: Lectura pública, escritura autenticada
    match /website_content/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Usuarios: Solo el propietario puede leer/escribir
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Cotizaciones: Solo usuarios autenticados
    match /quotes/{quoteId} {
      allow read, write: if request.auth != null;
    }
    
    // Mensajes de contacto: Escritura pública (formulario), lectura autenticada (admin)
    match /contact_messages/{messageId} {
      allow create: if true; // Permitir que cualquiera envíe mensajes desde el formulario
      allow read, update, delete: if request.auth != null; // Solo admin puede leer/modificar
    }
    
    // Unidades: Solo usuarios autenticados
    match /units/{unitId} {
      allow read, write: if request.auth != null;
    }
    
    // Por defecto: Denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
